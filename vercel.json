{
  "buildCommand": "echo 'Skipping build on Vercel (prebuilt locally)'",
  "outputDirectory": "build",
  "functions": {
    "api/*.js": {
      "includeFiles": "server/kb/index.json"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
